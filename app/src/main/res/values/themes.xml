<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default; values-night switches to dark when the phone is in dark mode -->
    <style name="Theme.Stride" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/stride_bg</item>
        <item name="android:statusBarColor">@color/stride_bg</item>
        <item name="android:navigationBarColor">@color/stride_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
